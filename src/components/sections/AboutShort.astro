---
import type { Section } from '../../lib/schemas';
import EdgeImage from '../ui/EdgeImage.astro';
import Markdown from '../ui/Markdown.astro';
import CtaLink from '../ui/CtaLink.astro';

import { ed } from '../../lib/edit';
interface Props {
  data: Extract<Section, { type: 'aboutShort' }>;
}
const l = Astro.locals;
const { data } = Astro.props;
const split = data.variant === 'split' && !!data.image;
---

<section class="section">
  <div class:list={['container-x grid gap-10 md:gap-16', split && 'items-center md:grid-cols-2']}>
    {
      data.image && (
        <div data-reveal class:list={[!split && 'mx-auto w-full max-w-md']}>
          <EdgeImage
            src={data.image}
            alt={data.imageAlt ?? ''}
            ratio={4 / 5}
            edge={data.imageEdge ?? 'frame'}
            intensity={data.edgeIntensity}
            sizes="(min-width: 768px) 50vw, 100vw"
          />
        </div>
      )
    }
    <div data-reveal class:list={[!split && 'mx-auto max-w-2xl text-center']}>
      {data.eyebrow && <p class="eyebrow mb-4" {...ed(l, 'eyebrow')}>{data.eyebrow}</p>}
      {data.title && <h2 class="h2 mb-6" {...ed(l, 'title')}>{data.title}</h2>}
      <Markdown content={data.text} class={split ? '' : 'mx-auto'} />
      {data.cta && <CtaLink link={data.cta} editPath="cta" variant="secondary" where="About singkat" class="mt-8" />}
    </div>
  </div>
</section>
