---
// Pratinjau contoh beranda (examples/home-*.json) tanpa menimpa konten asli: memakai mekanisme preview editor.
// noindex, di luar sitemap. Terapkan ke situs: `npm run example <nama>`.
import type { GetStaticPaths } from 'astro';
import HomeView from '../../../components/pages/HomeView.astro';
import { getSite, getTheme } from '../../../lib/content';
import { getEntry } from 'astro:content';
import { homeSchema, navigationSchema, siteSchema, themeSchema } from '../../../lib/schemas';

export const getStaticPaths = (() => {
  const files = import.meta.glob<{ default: Record<string, any> }>('../../../../examples/home-*.json', { eager: true });
  return Object.entries(files).map(([p, m]) => ({ params: { name: p.match(/home-(.+)\.json$/)![1] }, props: { ex: m.default } }));
}) satisfies GetStaticPaths;

const ex = Astro.props.ex as Record<string, any>;
const [site, theme, nav] = await Promise.all([getSite(), getTheme(), getEntry('navigation', 'navigation')]);
// Validasi lewat skema yang sama dengan konten asli: contoh yang rusak menggagalkan build.
const home = homeSchema.parse(ex.home);
Astro.locals.preview = {
  site: siteSchema.parse({ ...site, ...ex.site }),
  theme: themeSchema.parse({ ...theme, ...ex.theme }),
  navigation: navigationSchema.parse({ ...nav!.data, ...ex.navigation }),
  home,
};
---

<HomeView sections={home.sections} />
