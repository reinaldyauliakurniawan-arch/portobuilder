---
// Ikon panah SVG (pengganti glyph ↗ → ← yang bentuknya beda per font). Ukuran mengikuti teks.
interface Props {
  dir?: 'ne' | 'e' | 'w';
  class?: string;
}
const { dir = 'e', class: cls } = Astro.props;
const d = { ne: 'M7 17 17 7M8 7h9v9', e: 'M5 12h14M13 6l6 6-6 6', w: 'M19 12H5M11 6l-6 6 6 6' }[dir];
---

<svg class:list={['arrow-i', `arrow-${dir}`, cls]} viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
