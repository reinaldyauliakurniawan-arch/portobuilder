---
import type { Section } from '../../lib/schemas';
import Markdown from '../ui/Markdown.astro';

import { ed } from '../../lib/edit';
interface Props {
  data: Extract<Section, { type: 'richText' }>;
}
const l = Astro.locals;
const { data } = Astro.props;
---

<section class="section">
  {
    data.variant === 'two-column' ? (
      <div class="container-x grid gap-8 md:grid-cols-12" data-reveal>
        {data.title && <h2 class="h2 md:col-span-5" {...ed(l, 'title')}>{data.title}</h2>}
        <Markdown content={data.body} class={data.title ? 'md:col-span-7' : 'md:col-span-7 md:col-start-6'} />
      </div>
    ) : (
      <div class="container-x" data-reveal>
        <div class="mx-auto max-w-[680px]">
          {data.title && <h2 class="h2 mb-8" {...ed(l, 'title')}>{data.title}</h2>}
          <Markdown content={data.body} />
        </div>
      </div>
    )
  }
</section>
