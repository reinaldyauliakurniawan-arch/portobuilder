---
import type { Section } from '../../lib/schemas';
import Markdown from '../ui/Markdown.astro';

import { ed } from '../../lib/edit';
interface Props {
  data: Extract<Section, { type: 'faq' }>;
}
const l = Astro.locals;
const { data } = Astro.props;
---

<section class="section">
  {
    data.variant === 'accordion' ? (
      <div class="container-x">
        <div class="mx-auto max-w-3xl">
          <h2 class="h2 mb-10" data-reveal {...ed(l, 'title')}>{data.title}</h2>
          <div class="flex flex-col gap-4">
            {data.items.map((q, i) => (
              <details class="card faq-item" data-reveal>
                <summary class="flex cursor-pointer items-center justify-between gap-6 p-6 font-semibold">
                  <span {...ed(l, `items.${i}.question`)}>{q.question}</span>
                  <span class="faq-icon" aria-hidden="true" />
                </summary>
                <Markdown content={q.answer} class="px-6 pb-6 text-muted" />
              </details>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="container-x grid gap-10 md:grid-cols-12">
        <h2 class="h2 md:col-span-4" data-reveal {...ed(l, 'title')}>{data.title}</h2>
        <dl class="flex flex-col gap-4 md:col-span-8">
          {data.items.map((q, i) => (
            <div class="card p-6 md:p-8" data-reveal>
              <dt class="h3 mb-3" {...ed(l, `items.${i}.question`)}>{q.question}</dt>
              <dd>
                <Markdown content={q.answer} class="text-muted" />
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  summary {
    list-style: none;
    border-radius: var(--radius-card);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 9px 2px;
    background: var(--accent);
    border-radius: 2px;
    transition: transform 0.3s;
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq-icon::after {
    transform: rotate(0);
  }
</style>
