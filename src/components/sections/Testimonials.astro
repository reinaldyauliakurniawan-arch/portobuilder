---
import type { Section } from '../../lib/schemas';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';

import { ed } from '../../lib/edit';
import { getStrings } from '../../lib/i18n';
interface Props {
  data: Extract<Section, { type: 'testimonials' }>;
}
const l = Astro.locals;
const { data } = Astro.props;
const carousel = data.variant === 'carousel' && data.items.length > 1;
const t = await getStrings(Astro.locals);
---

<section class="section">
  <div class="container-x">
    <div class="mb-10 flex items-end justify-between gap-6 md:mb-14">
      {data.title && <h2 class="h2" data-reveal {...ed(l, 'title')}>{data.title}</h2>}
      {
        carousel && (
          <div class="flex gap-3" data-carousel-controls>
            <button type="button" class="carousel-btn" data-dir="-1" aria-label={t.prevTestimonial}><Icon name="chevron-left" /></button>
            <button type="button" class="carousel-btn" data-dir="1" aria-label={t.nextTestimonial}><Icon name="chevron-right" /></button>
          </div>
        )
      }
    </div>
    <ul
      class:list={[carousel ? 'carousel' : 'grid gap-8 md:grid-cols-2 lg:grid-cols-3']}
      role="list"
      tabindex={carousel ? 0 : undefined}
      aria-label={carousel ? t.testimonialsHint : undefined}
    >
      {
        data.items.map((t, i) => (
          <li class="card flex flex-col justify-between gap-8 p-8" data-reveal>
            <blockquote class="font-head text-[1.3rem] leading-snug" style="font-weight:var(--heading-weight)">
              <p>“<span {...ed(l, `items.${i}.quote`)}>{t.quote}</span>”</p>
            </blockquote>
            <div class="flex items-center gap-4">
              {t.photo && (
                <div class="w-12 shrink-0 overflow-hidden rounded-full">
                  <Img src={t.photo} alt="" ratio={1} sizes="48px" maxWidth={96} />
                </div>
              )}
              <p>
                <span class="block font-semibold" {...ed(l, `items.${i}.name`)}>{t.name}</span>
                {t.role && <span class="meta" {...ed(l, `items.${i}.role`)}>{t.role}</span>}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel-controls]:not([data-ready])').forEach((ctrl) => {
      ctrl.dataset.ready = '1';
      const track = ctrl.closest('section')!.querySelector<HTMLElement>('.carousel')!;
      ctrl.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => {
          const item = track.querySelector<HTMLElement>('li');
          track.scrollBy({ left: Number(b.dataset.dir) * ((item?.offsetWidth ?? 300) + 32), behavior: 'smooth' });
        }),
      );
    });
  }
  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 440px);
    gap: 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 8px 16px 40px;
    margin: -8px -16px 0;
  }
  .carousel::-webkit-scrollbar {
    display: none;
  }
  .carousel > li {
    scroll-snap-align: start;
  }
  .carousel-btn {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--surface);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .carousel-btn:hover {
    background: var(--text);
    color: var(--bg);
  }
</style>
