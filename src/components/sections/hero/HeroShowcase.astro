---
// Hero Showcase: kartu gelap besar (skema gelap lokal) di atas latar terang, teks kiri + foto kanan,
// panel kaca di bawah. Kontras teks dihitung dari foto: scrim gradien (teks) dan scrim kaca (panel).
import type { Section } from '../../../lib/schemas';
import { ctaHref, isExternal } from '../../../lib/content';
import { getColors } from '../../../lib/theme-colors';
import { regionLum } from '../../../lib/image';
import { darkScheme, glassScrim, scrimAlpha } from '../../../lib/color';
import { ed } from '../../../lib/edit';
import Img from '../../ui/Img.astro';
import VideoModal from '../../ui/VideoModal.astro';
import ServiceColumns from './ServiceColumns.astro';
import { getStrings } from '../../../lib/i18n';

interface Props {
  data: Extract<Section, { type: 'hero' }>;
  first?: boolean;
  eager?: boolean;
  index?: number;
}
const { data, first = false, eager = false, index = 0 } = Astro.props;
const l = Astro.locals;
const H = first ? 'h1' : 'h2';
const { colors } = await getColors(l);
const scheme = darkScheme(colors.vars['--bg'], colors.vars['--accent']);
const vars = Object.entries(scheme)
  .map(([k, v]) => `${k}:${v}`)
  .join(';');

// Kondisi terburuk: area teks (kiri) & area panel kaca (bawah tengah).
const img = data.image;
const textWorst = img ? await regionLum(img, { x0: 0, y0: 0.15, x1: 0.5, y1: 0.85 }, 0.95, l) : 0;
const textScrim = img ? scrimAlpha(textWorst, '#000000', '#ffffff', 4.5) : 0;
const panelWorst = img ? await regionLum(img, { x0: 0.15, y0: 0.72, x1: 0.85, y1: 1 }, 0.95, l) : 0;
const panelScrim = img ? glassScrim(panelWorst) : 0;

const primary = data.primaryCta ? { ...data.primaryCta, href: await ctaHref(data.primaryCta, 'Hero', l) } : undefined;
const secondary = !data.heroVideoUrl && data.secondaryCta ? { ...data.secondaryCta, href: await ctaHref(data.secondaryCta, 'Hero', l) } : undefined;
const modalId = `hero-video-${index}`;
const arrow = 'M7 17 17 7M8 7h9v9';
const t = await getStrings(Astro.locals);
---

<section class="showcase" data-hero data-scroll-scale>
  <div class="sc-card" style={`${vars};--focus-x:${data.focusX}%`} data-card-intro>
    {
      img && (
        <div class="sc-photo edge-fade-left" data-photo-intro="showcase" data-parallax="8">
          <Img src={img} alt={data.imageAlt ?? ''} eager={eager} sizes="(min-width: 768px) 100vw, 100vw" maxWidth={2400} />
        </div>
      )
    }
    {textScrim > 0 && <div class="sc-scrim" style={`--a:${textScrim}`} aria-hidden="true" />}
    <div class="sc-content">
      {
        data.eyebrow && (
          <p class="sc-eyebrow" data-rise {...ed(l, 'eyebrow')}>
            {data.eyebrow}
          </p>
        )
      }
      <H class="sc-title" data-rise {...ed(l, 'headline')}>
        {data.headline}
      </H>
      {
        data.subheadline && (
          <p class="sc-sub" data-rise {...ed(l, 'subheadline')}>
            {data.subheadline}
          </p>
        )
      }
      <div class="sc-actions" data-rise>
        {
          primary && (
            <a href={primary.href} class="btn btn-primary sc-pill" target={isExternal(primary.href) ? '_blank' : undefined} rel={isExternal(primary.href) ? 'noopener' : undefined}>
              <span {...ed(l, 'primaryCta.label')}>{primary.label}</span>
              <svg class="i-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
            </a>
          )
        }
        {
          data.heroVideoUrl ? (
            <button type="button" class="btn sc-ghost sc-pill" data-video-open={modalId}>
              <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
              {t.watchVideo}
            </button>
          ) : (
            secondary && (
              <a href={secondary.href} class="btn sc-ghost sc-pill">
                <span {...ed(l, 'secondaryCta.label')}>{secondary.label}</span>
              </a>
            )
          )
        }
      </div>
    </div>
    {
      data.serviceColumns.length > 0 && (
        <div class="sc-panel-wrap" style={`--cols:${data.serviceColumns.length}`}>
          <ServiceColumns items={data.serviceColumns} glass scrim={panelScrim} class="sc-panel" />
          {data.serviceColumns.length > 1 && (
            <div class="sc-dots" aria-hidden="true">
              {data.serviceColumns.map(() => (
                <span />
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
  {data.heroVideoUrl && <VideoModal id={modalId} url={data.heroVideoUrl} title={data.headline ?? 'Video'} />}
</section>

<script>
  // Indikator titik carousel panel kaca (mobile).
  function initDots() {
    document.querySelectorAll<HTMLElement>('.sc-panel-wrap:not([data-ready])').forEach((wrap) => {
      wrap.dataset.ready = '1';
      const track = wrap.querySelector<HTMLElement>('.sc-panel');
      const dots = [...wrap.querySelectorAll<HTMLElement>('.sc-dots span')];
      if (!track || !dots.length) return;
      const update = () => {
        const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        dots.forEach((d, k) => d.classList.toggle('on', k === i));
      };
      track.addEventListener('scroll', update, { passive: true });
      update();
    });
  }
  document.addEventListener('astro:page-load', initDots);
</script>

<style>
  .showcase {
    padding: 24px;
  }
  .sc-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 28px;
    min-height: min(calc(100svh - 48px), 880px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px clamp(24px, 5vw, 72px) 200px;
    background: var(--bg);
    color: var(--text);
  }
  .sc-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .sc-photo :global(img) {
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-x, 70%) 50%;
    aspect-ratio: auto !important;
  }
  .sc-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(var(--scrim) / var(--a)) 0%, rgb(var(--scrim) / var(--a)) 35%, transparent 62%);
  }
  .sc-content {
    /* 560px di brief; Montserrat lebih lebar, jadi 640px supaya judul tetap ±2 baris */
    max-width: 640px;
    margin-top: -4vh;
  }
  .sc-eyebrow {
    display: inline-flex;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    font-size: 13px;
    margin-bottom: 24px;
  }
  .sc-title {
    font-size: clamp(32px, 3.6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: none;
  }
  .sc-sub {
    margin-top: 20px;
    font-size: clamp(15px, 0.9rem + 0.1vw, 16px);
    color: var(--muted);
    max-width: 46ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .sc-pill {
    border-radius: 9999px;
  }
  .sc-ghost {
    border: 1px solid rgb(255 255 255 / 0.3);
    color: var(--text);
    background: transparent;
  }
  .sc-ghost:hover {
    background: rgb(255 255 255 / 0.08);
  }
  .btn-primary.sc-pill:hover {
    filter: brightness(1.08);
  }
  .i-arrow,
  .i-play {
    transition: transform 0.2s;
  }
  .sc-pill:hover .i-arrow {
    transform: translate(2px, -2px);
  }
  .sc-pill:hover .i-play {
    transform: scale(1.1);
  }
  .sc-panel-wrap {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: min(70%, 1000px);
    transform: translateX(-50%);
  }
  .sc-dots {
    display: none;
  }
  @media (max-width: 767px) {
    .showcase {
      padding: 12px;
    }
    .sc-card {
      border-radius: 20px;
      justify-content: flex-end;
      padding: 96px 20px 24px;
      min-height: calc(100svh - 24px);
    }
    .sc-photo :global(img) {
      object-position: 50% 0%;
    }
    .sc-photo::after {
      background: linear-gradient(to top, var(--bg) 0%, var(--bg) 38%, transparent 78%);
    }
    .sc-scrim {
      background: linear-gradient(to top, rgb(var(--scrim) / var(--a)) 0%, transparent 60%);
    }
    .sc-content {
      margin-top: 0;
    }
    .sc-sub {
      -webkit-line-clamp: unset; /* di HP jangan potong isi */
    }
    .sc-panel-wrap {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 24px;
    }
    .sc-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 10px;
    }
    .sc-dots span {
      width: 6px;
      height: 6px;
      border-radius: 9999px;
      background: var(--glass-border);
    }
    .sc-dots span.on {
      background: var(--text);
    }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    .sc-card {
      overflow: visible;
    }
  }
</style>
